          "$value": "{primitive.color.white}"
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "{primitive.color.zinc.800}"
        },
        "focus": {
          "$type": "color",
          "$value": "{semantic.dark.bg.brand}"
        }
