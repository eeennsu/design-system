{
  "$description": "semantic 색 (브랜드 base). :root 변수 이름은 공개 계약이다(C-5b). 값은 primitive 참조 또는 같은 모드의 semantic 별칭만 쓴다.",
  "semantic": {
    "light": {
      "bg": {
        "canvas": {
          "$type": "color",
          "$value": "{primitive.color.gray.100}"
        },
        "surface": {
          "$type": "color",
          "$value": "{primitive.color.white}"
        },
        "surface-muted": {
          "$type": "color",
          "$value": "{primitive.color.gray.200}"
        },
        "surface-hover": {
          "$type": "color",
          "$value": "{primitive.color.gray.300}"
        },
        "brand": {
          "$type": "color",
          "$value": "{primitive.color.blue.550}"
        },
        "brand-hover": {
          "$type": "color",
          "$value": "{primitive.color.blue.650}"
        },
        "danger": {
          "$type": "color",
          "$value": "{primitive.color.red.600}"
        },
        "danger-hover": {
          "$type": "color",
          "$value": "{primitive.color.red.700}"
        },
        "overlay": {
          "$type": "color",
          "$value": "{primitive.color.black-alpha.50}"
        }
      },
      "fg": {
        "default": {
          "$type": "color",
          "$value": "{primitive.color.gray.900}"
        },
        "muted": {
          "$type": "color",
          "$value": "{primitive.color.gray.550}"
        },
        "brand": {
          "$type": "color",
          "$value": "{primitive.color.blue.650}"
        },
        "danger": {
          "$type": "color",
          "$value": "{primitive.color.red.700}"
        },
        "on-brand": {
          "$type": "color",
          "$value": "{primitive.color.white}"
        },
        "on-danger": {
          "$type": "color",
          "$value": "{primitive.color.white}"
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "{primitive.color.gray.200}"
        },
        "focus": {
          "$type": "color",
          "$value": "{semantic.light.bg.brand}"
        }
      }
    },
    "dark": {
