        "$value": "{primitive.spacing.3}"
      },
      "markerWidth": {
        "$type": "dimension",
        "$value": "{primitive.spacing.4}"
      },
      "text": {
        "$type": "typography",
        "$value": "{component.text.md}"
      }
    }
  }
}
