{
  "$description": "타이포 원자값과 폰트 패밀리. 스텝 조합은 component/text.json 이 만든다. 폰트 파일은 동봉하지 않는다(C-7b, AC-6c).",
  "primitive": {
    "typography": {
      "fontFamily": {
        "sans": {
          "$type": "fontFamily",
          "$value": [
            "Pretendard Variable",
            "Pretendard",
            "-apple-system",
            "BlinkMacSystemFont",
            "Segoe UI",
            "sans-serif"
          ],
          "$description": "사용자 확정(2026-09-05, plan D-1). 로딩은 소비 프로젝트 책임.",
          "$extensions": {
            "ds.native": "Pretendard"
          }
        }
      },
      "fontSize": {
        "14": { "$type": "dimension", "$value": "14px" },
        "16": { "$type": "dimension", "$value": "16px" },
        "18": { "$type": "dimension", "$value": "18px" },
        "20": { "$type": "dimension", "$value": "20px" },
        "24": { "$type": "dimension", "$value": "24px" }
      },
      "lineHeight": {
        "20": { "$type": "dimension", "$value": "20px" },
        "24": { "$type": "dimension", "$value": "24px" },
        "28": { "$type": "dimension", "$value": "28px" },
        "32": { "$type": "dimension", "$value": "32px" }
      },
      "fontWeight": {
        "regular": { "$type": "fontWeight", "$value": 400 },
        "medium": { "$type": "fontWeight", "$value": 500 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold": { "$type": "fontWeight", "$value": 700 }
      }
    }
  }
}
