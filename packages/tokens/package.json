{
  "name": "@eeennsu/tokens",
  "version": "0.2.0",
  "description": "디자인 시스템 토큰 · 컴포넌트 계약 타입 (웹 · React Native 공용)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "themes"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./brands/base": {
      "types": "./dist/brands/base.d.ts",
      "default": "./dist/brands/base.js"
    },
    "./brands/bakery": {
      "types": "./dist/brands/bakery.d.ts",
      "default": "./dist/brands/bakery.js"
    },
    "./themes/*.css": "./themes/*.css"
  },
  "scripts": {
    "build": "tsx scripts/build.ts && tsc -p tsconfig.json",
    "test": "vitest run --typecheck --passWithNoTests"
  },
  "peerDependencies": {
    "@types/react": "*"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@types/react": "^19.2.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13"
  }
}
